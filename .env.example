# Copy to `.env` and adjust. Docker Compose reads `.env` automatically.
# `.env` itself is git-ignored and dockerignored - never commit real values.

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
POSTGRES_DB=url_shortner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Public origin of the API. Short links and QR codes are built from this, so in
# production it must be the real domain - not localhost, or every generated link
# will point at the visitor's own machine.
APP_BASE_URL=http://localhost:8080

# Origins allowed to call the API from a browser, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------
# Security
# ------------------------------------------------------------------
# Base64-encoded HMAC-SHA256 key, at least 256 bits. Generate one with:
#   openssl rand -base64 64
# Anyone holding this key can mint tokens for any account - treat it as a password.
JWT_SECRET=1234567890123456789012345678901234567890123456789012345678901234

# Token lifetime in milliseconds (86400000 = 24h).
JWT_EXPIRATION=86400000
