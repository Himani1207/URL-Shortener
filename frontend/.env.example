# Copy to `.env` for local development.
#
# Vite inlines VITE_* variables at BUILD time, so changing one needs a rebuild -
# not just a restart. They are also visible to anyone who reads the bundle, so
# never put a secret here.

# Base URL of the Spring Boot API.
#
# Leave this EMPTY for local development: the Vite dev server proxies /api to
# localhost:8080, so requests stay same-origin and CORS never applies.
#
# On Vercel it MUST be set to the API's public origin, with no trailing slash —
# there is no proxy in production, so an empty value would make the browser
# request /api from the Vercel domain, which serves the SPA and returns HTML.
# The failure looks like "Unexpected token '<'" rather than a network error.
#   VITE_API_BASE_URL=https://your-api.onrender.com
VITE_API_BASE_URL=

# Origin that short links resolve on — must match the backend's `app.base-url`.
#
# Only used to preview a link before it exists (the Create page shows the address a
# custom alias would claim). Every link that has actually been created carries its
# own fully qualified `shortUrl` from the server.
#
# Leave EMPTY for local development: the fallback swaps Vite's :5173 for the
# backend's :8080. That guess cannot work on Vercel, where the origin has no
# port to swap, so the preview would show the Vercel domain — a host that does
# not serve short links. Set it to the same value as VITE_API_BASE_URL.
#   VITE_SHORT_BASE_URL=https://your-api.onrender.com
VITE_SHORT_BASE_URL=
